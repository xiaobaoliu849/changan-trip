OPENAI_NEXT_API_KEY=
EVEROS_API_KEY=
# Only needed to regenerate the pre-made voice clips (python -m backend.make_voice).
# In-game lines use Edge TTS, which works in mainland China; set LIVE_TTS=gemini only on a server that can reach Google.
GEMINI_API_KEY=
# LIVE_TTS=edge
# Optional overrides
# OPENAI_NEXT_BASE_URL=https://api.openai-next.com/v1
# EVEROS_API_URL=https://api.evermind.ai
# AI_TEXT_MODEL=claude-sonnet-5-5
# AI_IMAGE_MODEL=gpt-image-2
# AI_IMAGE_QUALITY=low
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# GEMINI_TTS_VOICE=Gacrux
# TTS_VOICE=zh-CN-YunjianNeural
# Optional: Google Agent Platform (Vertex AI) API key. When set, Gemini TTS (backend/make_voice.py) uses it instead of GEMINI_API_KEY.
AGENT_PLATFORM_API_KEY=
